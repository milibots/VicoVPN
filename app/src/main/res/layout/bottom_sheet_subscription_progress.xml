<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_premium_sheet"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="18dp"
    android:paddingEnd="26dp"
    android:paddingBottom="30dp">

    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_premium_sheet_handle" />

    <TextView
        android:id="@+id/subscriptionProgressTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="@string/finding_best_connection"
        android:textColor="@color/vico_premium_white"
        android:textSize="24sp" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/subscriptionProgressBar"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="28dp"
        android:indeterminate="true"
        app:indicatorColor="@color/vico_premium_orange"
        app:indicatorDirectionCircular="clockwise"
        app:indicatorSize="100dp"
        app:trackColor="@color/vico_premium_outline"
        app:trackThickness="7dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/subscriptionCenterActionButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:minHeight="0dp"
        android:minWidth="104dp"
        android:text="@string/stop"
        android:textAllCaps="false"
        android:textColor="@color/vico_premium_orange"
        android:textSize="14sp"
        app:cornerRadius="20dp" />

    <TextView
        android:id="@+id/subscriptionProgressStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="@string/subscription_looking_simple"
        android:textColor="@color/vico_premium_white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/subscriptionProgressDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/subscription_looking_detail_simple"
        android:textColor="@color/vico_premium_muted"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/subscriptionCancelButton"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
</LinearLayout>