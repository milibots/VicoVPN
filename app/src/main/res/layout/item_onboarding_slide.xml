<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="8dp"
    android:paddingEnd="22dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/obBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ob7_back"
            android:padding="12dp"
            android:src="@drawable/ic_onboarding_back"
            android:tint="@color/vico_premium_white"
            android:visibility="invisible" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/obProgress"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            app:indicatorColor="@color/vico_premium_orange"
            app:trackColor="@color/vico_premium_outline"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/obSkipButton"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/ob7_skip"
            android:textColor="@color/vico_premium_muted"
            android:textSize="14sp"
            android:visibility="invisible" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="18dp">

            <ImageView
                android:id="@+id/obMascot"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="yes"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/obTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:maxLines="4"
                android:textColor="@color/vico_premium_white"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/obDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:maxLines="8"
                android:textColor="@color/vico_premium_muted"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/obLanguageChoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/obPersianButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="56dp"
                    android:text="@string/ob7_language_persian"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/obEnglishButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minHeight="56dp"
                    android:text="@string/ob7_language_english"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    app:cornerRadius="22dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/obDiscoveryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_onboarding_language_unselected"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:textColor="@color/vico_premium_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/obPermissionMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:maxLines="6"
                android:text="@string/ob7_permission_declined"
                android:textColor="@color/vico_premium_error"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/obPrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:minHeight="60dp"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/vico_premium_orange"
        app:cornerRadius="28dp" />

</LinearLayout>
