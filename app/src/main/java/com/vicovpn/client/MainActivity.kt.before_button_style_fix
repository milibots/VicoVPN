    private fun ensureInternetAvailable():
        Boolean {
        if (hasUsableInternet) {
            return true
        }

        updateNetworkAvailabilityUi()

        toast(
            getString(
                R.string.network_required_message
            )
        )

        binding.offlineBanner
            .animate()
            .cancel()

        binding.offlineBanner
            .translationY =
            -10.dp.toFloat()

        binding.offlineBanner
            .alpha = 0.55f

        binding.offlineBanner
            .animate()
            .translationY(0f)
            .alpha(1f)
            .setDuration(220L)
            .start()

        return false
    }

    private fun updateNetworkAvailabilityUi() {
        binding.offlineBanner.visibility =
            if (hasUsableInternet) {
                View.GONE
            } else {
                View.VISIBLE
            }

        val hasServer =
            serverStore.getActiveServer() !=
                null

        val mayDisconnect =
            isVpnActiveOrStarting(
                snapshot.stage
            )

        binding.connectButton.isEnabled =
            mayDisconnect ||
                (
                    hasUsableInternet &&
                        hasServer
                    )

        binding.connectButton.alpha =
            if (
                binding.connectButton
                    .isEnabled
            ) {
                1f
            } else {
                0.55f
            }
    }

