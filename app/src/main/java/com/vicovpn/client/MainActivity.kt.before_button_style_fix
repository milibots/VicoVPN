    private fun maybeAutoUpdateFreeServers() {
        val servers =
            serverStore.getServers()

        val hasFreeServers =
            servers.any {
                it.origin ==
                    ServerOrigin
                        .FREE_SUBSCRIPTION
            }

        val firstAutoConnectDone =
            getSharedPreferences(
                SETTINGS_PREFERENCES,
                MODE_PRIVATE
            ).getBoolean(
                KEY_FIRST_AUTO_CONNECT_DONE,
                false
            )

        if (!firstAutoConnectDone) {
            binding.root.postDelayed(
                {
                    if (
                        isFinishing ||
                        !ensureInternetAvailable()
                    ) {
                        return@postDelayed
                    }

                    if (hasFreeServers) {
                        serverStore
                            .activateBestFreeServer()

                        refreshServerUi()
                        requestVpnStart()
                    } else {
                        connectAfterFreeUpdate = true
                        smartConnectTriggered = false

                        loadFreeSubscriptions(
                            showUi = true
                        )
                    }
                },
                650L
            )

            return
        }

        val lastUpdate =
            freeServerSettings
                .getLastUpdateAt()

        val refreshMode =
            freeServerSettings
                .getAutoRefreshMode()

        val staleAfterMs =
            when (refreshMode) {
                AutoRefreshMode.OFF ->
                    if (hasFreeServers) {
                        Long.MAX_VALUE
                    } else {
                        0L
                    }

                AutoRefreshMode.DAILY ->
                    24L * 60L * 60L * 1_000L

                AutoRefreshMode.EVERY_THREE_DAYS ->
                    72L * 60L * 60L * 1_000L
            }

        val isStale =
            System.currentTimeMillis() -
                lastUpdate >= staleAfterMs

        if (!hasFreeServers || isStale) {
            binding.root.postDelayed(
                {
                    if (!isFinishing) {
                        connectAfterFreeUpdate = false
                        smartConnectTriggered = false

                        loadFreeSubscriptions(
                            showUi =
                                !hasFreeServers
                        )
                    }
                },
                900L
            )
        }
    }

    private fun loadFreeSubscriptions(
        showUi: Boolean = true
    ) {
        discoveryUiSuppressed =
            !showUi
        lastDiscoveryWorking = 0

        if (!ensureInternetAvailable()) {
            discoveryUiSuppressed = false
            return
        }

        if (
            freeServerSettings.isWifiOnly() &&
            !isConnectedToWifi()
        ) {
            toast(
                getString(
                    R.string.wifi_required_for_free_update
                )
            )
            return
        }

        if (
            snapshot.stage in
                setOf(
                    VpnStage.PREPARING,
                    VpnStage.ESTABLISHING_TUN,
                    VpnStage.STARTING_XRAY,
                    VpnStage.VERIFYING,
                    VpnStage.STOPPING
                )
        ) {
            toast(
                getString(
                    R.string.subscription_wait_for_connection_transition
                )
            )
            return
        }

        if (subscriptionImporter != null) {
            toast(
                getString(
                    R.string.subscription_import_running
                )
            )
            return
        }

        val deviceProfile =
            DevicePerformanceProfile.detect(this)

        if (showUi) {
            showFreeTestProgressDialog(
                getString(
                    R.string.subscription_preparing_profile,
                    deviceProfile.label
                )
            )
        }

        val importer =
            SubscriptionImporter(
                registryUrl =
                    subscriptionSettings.getRegistryUrl(),
                maxSourceCount = 50,
                maxConfigs = 5000,
                downloadThreads =
                    deviceProfile.downloadThreads
            )

        subscriptionImporter = importer

        subscriptionExecutor.execute {
            val result =
                importer.run { progress ->
                    if (!discoveryUiSuppressed) {
                        runOnUiThread {
                            renderSubscriptionProgress(
                                progress = progress,
                                title =
                                    freeTestDialog
                                        ?.findViewById(
                                            R.id.subscriptionProgressTitle
                                        )
                                        ?: return@runOnUiThread,
                                status =
                                    freeTestStatus
                                        ?: return@runOnUiThread,
                                detail =
                                    freeTestDetail
                                        ?: return@runOnUiThread,
                                progressBar =
                                    freeTestProgressBar
                                        ?: return@runOnUiThread
                            )
                        }
                    }
                }

            runOnUiThread {
                subscriptionImporter = null

                result.fold(
                    onSuccess = { imported ->
                        val parsedCandidates =
                            imported.configs
                                .asSequence()
                                .filter { rawLink ->
                                    runCatching {
                                        ShareLinkParser.parse(
                                            rawLink
                                        )
                                    }.isSuccess
                                }
                                .distinct()
                                .toList()

                        if (parsedCandidates.isEmpty()) {
                            closeFreeTestDialogAsError(
                                getString(
                                    R.string.subscription_no_valid_candidates
                                )
                            )
                            return@fold
                        }

                        DiagnosticsLog.add(
                            "SUBSCRIPTION_PARSE",
                            "downloaded=${imported.configs.size} parsed=${parsedCandidates.size}"
                        )

                        FreeServerUpdateStore(this)
                            .saveCandidates(
                                parsedCandidates
                            )

                        if (!discoveryUiSuppressed) {
                            freeTestStatus?.text =
                                getString(
                                    R.string.subscription_verifying_routes
                                )

                            freeTestDetail?.text =
                                getString(
                                    R.string.subscription_first_route_is_enough
                                )
                        }

                        startFreeServerTestService()
                    },
                    onFailure = { error ->
                        val message =
                            error.message
                                ?: getString(
                                    R.string.subscription_unknown_error
                                )

                        if (discoveryUiSuppressed) {
                            binding.subscriptionLastResultText.text =
                                message
                            discoveryUiSuppressed = false
                        } else {
                            closeFreeTestDialogAsError(
                                message
                            )
                        }
                    }
                )
            }
        }
    }

    private fun showFreeTestProgressDialog(
