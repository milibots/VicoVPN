    private fun requestVpnStart() {
        pendingVpnAction = PendingVpnAction.CONNECT

        if (!ensureInternetAvailable()) {
            return
        }

        val activeServer = serverStore.getActiveServer()
        if (activeServer == null) {
            toast(getString(R.string.no_active_server))
            selectTab(MainTab.SERVERS)
            return
        }

        val parseResult = runCatching {
            ShareLinkParser.parse(activeServer.rawLink)
        }

        if (parseResult.isFailure) {
            toast(getString(R.string.invalid_profile))
            return
        }

        val prepareIntent = VpnService.prepare(this)
        if (prepareIntent != null) {
            vpnPermission.launch(prepareIntent)
        } else {
            startVpnService()
        }
    }

    private fun startVpnService() {
        val activeServer = serverStore.getActiveServer()
        if (activeServer == null) {
            toast(getString(R.string.no_active_server))
            return
        }

        val serviceIntent = Intent(this, VicoVpnService::class.java)
            .setAction(VicoVpnService.ACTION_CONNECT)
            .putExtra(VicoVpnService.EXTRA_PROFILE, activeServer.rawLink)

        ContextCompat.startForegroundService(this, serviceIntent)
    }

    private fun stopVpnService() {
        startService(
            Intent(this, VicoVpnService::class.java)
                .setAction(VicoVpnService.ACTION_STOP)
        )
    }

    private fun isVpnActiveOrStarting(stage: VpnStage): Boolean {
        return stage in activeOrStartingStages
    }

    private fun render(
        state: VpnSnapshot
    ) {
        val oldStage =
            snapshot.stage

        snapshot = state

        binding.statusText.text =
            localizedStageText(
                state.stage
            )

        renderPremiumConnectionState(
            state
        )

        binding.exitIpText.text =
            state.exitIp.ifBlank {
                getString(
                    R.string.not_available
                )
            }

        val locationLine =
            buildLocationLine(state)

        binding.exitLocationText.text =
            locationLine

        binding.exitLocationText.visibility =
            if (
                locationLine.isBlank()
            ) {
                View.GONE
            } else {
                View.VISIBLE
            }

        val networkLine =
            buildNetworkLine(state)

        binding.exitNetworkText.text =
            networkLine

        binding.exitNetworkText.visibility =
            if (
                networkLine.isBlank()
            ) {
                View.GONE
            } else {
                View.VISIBLE
            }

        updateTrafficSpeed(
            state
        )

        val trafficStore =
            TrafficStore(this)

        binding.lifetimeDownloadText.text =
            Formatter.formatFileSize(
                this,
                trafficStore
                    .getDownloadBytes()
            )

        binding.lifetimeUploadText.text =
            Formatter.formatFileSize(
                this,
                trafficStore
                    .getUploadBytes()
            )

        if (
            oldStage !=
                VpnStage.CONNECTED &&
            state.stage ==
                VpnStage.CONNECTED
        ) {
            getSharedPreferences(
                SETTINGS_PREFERENCES,
                MODE_PRIVATE
            ).edit()
                .putBoolean(
                    KEY_FIRST_AUTO_CONNECT_DONE,
                    true
                )
                .apply()
            connectedAtElapsed =
                SystemClock.elapsedRealtime()

            uiHandler.removeCallbacks(
                connectionTimerRunnable
            )

            uiHandler.post(
                connectionTimerRunnable
            )

            binding.root.postDelayed(
                {
                    maybeShowBatteryOptimizationPrompt()
                },
                1_200L
            )
        } else if (
            state.stage !=
                VpnStage.CONNECTED
        ) {
            uiHandler.removeCallbacks(
                connectionTimerRunnable
            )

            connectedAtElapsed = 0L

            binding.connectionTimerText
                .visibility = View.GONE
        }

        previousStage =
            state.stage

        updateNetworkAvailabilityUi()

        fullDiagnosticsText =
            createDiagnosticsText(state)

        renderDiagnosticsText()
    }

    private fun renderPremiumConnectionState(
        state: VpnSnapshot
    ) {
        val orbState =
            when (
                state.stage
            ) {
                VpnStage.CONNECTED ->
                    ConnectionOrbView
                        .State.CONNECTED

                VpnStage.PREPARING,
                VpnStage.ESTABLISHING_TUN,
                VpnStage.STARTING_XRAY,
                VpnStage.VERIFYING ->
                    ConnectionOrbView
                        .State.CONNECTING

                VpnStage.STOPPING ->
                    ConnectionOrbView
                        .State.DISCONNECTING

                VpnStage.ERROR ->
                    ConnectionOrbView
                        .State.ERROR

                else ->
                    ConnectionOrbView
                        .State.DISCONNECTED
            }

        binding.connectionOrb
            .setState(orbState)

        val active =
            isVpnActiveOrStarting(
                state.stage
            )

        val connected =
            state.stage ==
                VpnStage.CONNECTED

        val busy =
            state.stage in
                setOf(
                    VpnStage.PREPARING,
                    VpnStage.ESTABLISHING_TUN,
                    VpnStage.STARTING_XRAY,
                    VpnStage.VERIFYING,
                    VpnStage.STOPPING
                )

        val error =
            state.stage ==
                VpnStage.ERROR

        binding.connectionActionText.text =
            when {
                connected ->
                    getString(
                        R.string.disconnect
                    )

                state.stage ==
                    VpnStage.STOPPING ->
                    getString(
                        R.string.connection_disconnecting
                    )

                busy ->
                    getString(
                        R.string.connection_connecting
                    )

                error ->
                    getString(
                        R.string.connection_error
                    )

                else ->
                    getString(
                        R.string.connect
                    )
            }

        binding.connectButton
            .contentDescription =
            binding.connectionActionText.text

        binding.connectButton
            .backgroundTintList =
            ColorStateList.valueOf(
                ContextCompat.getColor(
                    this,
                    when {
                        connected ->
                            R.color
                                .vico_premium_power_on

                        busy ->
                            R.color
                                .vico_premium_power_busy

                        error ->
                            R.color
                                .vico_premium_power_error

                        else ->
                            R.color
                                .vico_premium_power_off
                    }
                )
            )

        binding.statusIcon.setImageResource(
            when {
                connected ->
                    R.drawable
                        .ic_status_connected

                busy ->
                    R.drawable
                        .ic_status_loading

                error ->
                    R.drawable
                        .ic_status_error

                else ->
                    R.drawable
                        .ic_status_disconnected
            }
        )

        binding.statusIconCard
            .setCardBackgroundColor(
                ContextCompat.getColor(
                    this,
                    when {
                        connected ->
                            R.color
                                .vico_premium_status_on

                        busy ->
                            R.color
                                .vico_premium_status_busy

                        error ->
                            R.color
                                .vico_premium_status_error

                        else ->
                            R.color
                                .vico_premium_status_off
                    }
                )
            )

        binding.statusIcon.imageTintList =
            ColorStateList.valueOf(
                ContextCompat.getColor(
                    this,
                    if (connected || busy) {
                        R.color
                            .vico_premium_orange
                    } else {
                        R.color
                            .vico_premium_white
                    }
                )
            )

        binding.connectionTimerText
            .visibility =
            if (connected) {
                View.VISIBLE
            } else {
                View.GONE
            }

        binding.connectButton.alpha =
            if (
                active ||
                hasUsableInternet
            ) {
                1f
            } else {
                0.55f
            }
    }

    private fun updateTrafficSpeed(
        state: VpnSnapshot
    ) {
        val now =
            SystemClock.elapsedRealtime()

        if (
            state.stage ==
                VpnStage.CONNECTED &&
            lastTrafficSampleAt > 0L &&
            state.uploadBytes >=
                lastUploadSample &&
            state.downloadBytes >=
                lastDownloadSample
        ) {
            val elapsed =
                (
                    now -
                        lastTrafficSampleAt
                    ).coerceAtLeast(1L)

            uploadBytesPerSecond =
                (
                    state.uploadBytes -
                        lastUploadSample
                    ) *
                    1_000L /
                    elapsed

            downloadBytesPerSecond =
                (
                    state.downloadBytes -
                        lastDownloadSample
                    ) *
                    1_000L /
                    elapsed
        } else {
            uploadBytesPerSecond = 0L
            downloadBytesPerSecond = 0L
        }

        lastTrafficSampleAt = now
        lastUploadSample =
            state.uploadBytes
        lastDownloadSample =
            state.downloadBytes

        binding.sessionUploadText.text =
            formatSpeed(
                uploadBytesPerSecond
            )

        binding.sessionDownloadText.text =
            formatSpeed(
                downloadBytesPerSecond
            )

        binding.connectionOrb
            .setTrafficBytesPerSecond(
                upload =
                    uploadBytesPerSecond,
                download =
                    downloadBytesPerSecond
            )
    }

    private fun formatSpeed(
        bytesPerSecond: Long
    ): String {
        val formatted =
            Formatter.formatShortFileSize(
                this,
                bytesPerSecond
                    .coerceAtLeast(0L)
            )

        return "$formatted/s"
    }

    private fun updateConnectionTimer() {
        if (
            snapshot.stage !=
                VpnStage.CONNECTED
        ) {
            binding.connectionTimerText
                .visibility = View.GONE
            return
        }

        if (
            connectedAtElapsed <= 0L
        ) {
            connectedAtElapsed =
                SystemClock.elapsedRealtime()
        }

        val elapsedSeconds =
            (
                SystemClock.elapsedRealtime() -
                    connectedAtElapsed
                ) /
                1_000L

        val hours =
            elapsedSeconds /
                3_600L

        val minutes =
            (
                elapsedSeconds %
                    3_600L
                ) /
                60L

        val seconds =
            elapsedSeconds %
                60L

        binding.connectionTimerText.text =
            String.format(
                java.util.Locale.US,
                "%02d:%02d:%02d",
                hours,
                minutes,
                seconds
            )

        binding.connectionTimerText
            .visibility = View.VISIBLE
    }

    private fun localizedStageText(stage: VpnStage): String {
        if (isPersianLanguage()) return stage.fa

        return stage.name
            .lowercase()
            .replace("_", " ")
