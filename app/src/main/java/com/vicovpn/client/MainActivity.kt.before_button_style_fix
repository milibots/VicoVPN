    private fun updateFreeTestProgressUi(
        completed: Int,
        total: Int,
        working: Int,
        failed: Int,
        message: String,
        finished: Boolean,
        success: Boolean
    ) {
        if (
            freeTestDialog == null ||
            freeTestDialog?.isShowing != true
        ) {
            showFreeTestProgressDialog(message)
        }

        freeTestStatus?.text =
            if (
                working > 0 &&
                !finished
            ) {
                getString(
                    R.string.subscription_route_ready_background
                )
            } else {
                message
            }

        freeTestDetail?.text =
            when {
                working > 0 &&
                    !finished ->
                    getString(
                        R.string.subscription_working_and_optimizing,
                        working
                    )

                finished &&
                    success ->
                    getString(
                        R.string.subscription_ready_count,
                        working
                    )

                else ->
                    getString(
                        R.string.subscription_friendly_progress,
                        working,
                        failed
                    )
            }

        freeTestProgressBar?.isIndeterminate =
            !finished

        configureDiscoveryButtons(
            working = working,
            finished = finished
        )

        if (finished) {
            refreshServerUi()

            freeTestProgressBar?.apply {
                isIndeterminate = false
                max = 100
                progress =
                    if (success) {
                        100
                    } else {
                        0
                    }
            }

            if (success) {
                binding.subscriptionLastResultText.text =
                    getString(
                        R.string.subscription_last_update_success,
                        working
                    )
            }

            smartConnectTriggered = false
            connectAfterFreeUpdate = false
            discoveryUiSuppressed = false
        }
    }

