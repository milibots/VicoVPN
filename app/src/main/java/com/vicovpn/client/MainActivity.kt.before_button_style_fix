    private fun selectTab(
        tab: MainTab,
        animate: Boolean = true,
        force: Boolean = false
    ) {
        if (!force && selectedTab == tab) return

        selectedTab = tab

        val targetSection = when (tab) {
            MainTab.CONNECTION -> binding.connectionSection
            MainTab.SERVERS -> binding.serversSection
            MainTab.LOGS -> binding.logsSection
            MainTab.SETTINGS -> binding.settingsSection
        }

        listOf(
            binding.connectionSection,
            binding.serversSection,
            binding.logsSection,
            binding.settingsSection
        ).forEach { section ->
            if (section === targetSection) {
                showSection(section, animate)
            } else {
                section.animate().cancel()
                section.visibility = View.GONE
                section.alpha = 1f
                section.translationY = 0f
            }
        }

        if (tab == MainTab.SERVERS || tab == MainTab.CONNECTION) {
            refreshServerUi()
        }

        updateNavigationAppearance(tab)
    }

    private fun showSection(section: View, animate: Boolean) {
        section.visibility = View.VISIBLE

        if (!animate) {
            section.alpha = 1f
            section.translationY = 0f
            return
        }

        section.alpha = 0f
        section.translationY = 14.dp.toFloat()
        section.animate()
            .alpha(1f)
            .translationY(0f)
            .setDuration(210L)
            .setInterpolator(AccelerateDecelerateInterpolator())
            .start()
    }

    private fun updateNavigationAppearance(
        selected: MainTab
    ) {
        val navItems = listOf(
            Triple(
                MainTab.CONNECTION,
                binding.navConnection,
                binding.navConnectionIcon
            ),
            Triple(
                MainTab.SERVERS,
                binding.navServers,
                binding.navServersIcon
            ),
            Triple(
                MainTab.LOGS,
                binding.navLogs,
                binding.navLogsIcon
            ),
            Triple(
                MainTab.SETTINGS,
                binding.navSettings,
                binding.navSettingsIcon
            )
        )

        navItems.forEach {
                (tab, view, icon) ->
            val isSelected =
                tab == selected

            view.setBackgroundResource(
                if (isSelected) {
                    R.drawable
                        .bg_nav_item_selected
                } else {
                    R.drawable
                        .bg_nav_item_transparent
                }
            )

            icon.imageTintList =
                ColorStateList.valueOf(
                    ContextCompat.getColor(
                        this,
                        if (isSelected) {
                            R.color
                                .vico_premium_white
                        } else {
                            R.color
                                .vico_premium_nav_icon
                        }
                    )
                )

            view.alpha =
                if (isSelected) 1f else 0.78f

            view.animate()
                .scaleX(
                    if (isSelected) 1f
                    else 0.92f
                )
                .scaleY(
                    if (isSelected) 1f
                    else 0.92f
                )
                .setDuration(180L)
                .start()
        }
    }

