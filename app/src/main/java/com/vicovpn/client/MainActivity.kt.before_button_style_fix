    private fun selectLanguage(languageTag: String) {
        require(languageTag == "fa" || languageTag == "en")

        getSharedPreferences(
            SETTINGS_PREFERENCES,
            MODE_PRIVATE
        ).edit()
            .putBoolean(KEY_LANGUAGE_SELECTED, true)
            .putString(KEY_LANGUAGE, languageTag)
            .apply()

        AppCompatDelegate.setApplicationLocales(
            LocaleListCompat.forLanguageTags(languageTag)
        )
    }

    private fun isPersianLanguage(): Boolean {
        val locales = resources.configuration.locales
        return !locales.isEmpty &&
            locales[0].language.equals("fa", ignoreCase = true)
    }

