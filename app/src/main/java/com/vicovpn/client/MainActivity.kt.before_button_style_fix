    private val freeTestReceiver =
        object : BroadcastReceiver() {
            override fun onReceive(
                context: Context?,
                intent: Intent?
            ) {
                if (intent == null) return

                val completed =
                    intent.getIntExtra(
                        VicoVpnService.EXTRA_FREE_COMPLETED,
                        0
                    )

                val total =
                    intent.getIntExtra(
                        VicoVpnService.EXTRA_FREE_TOTAL,
                        0
                    )

                val working =
                    intent.getIntExtra(
                        VicoVpnService.EXTRA_FREE_WORKING,
                        0
                    )

                val failed =
                    intent.getIntExtra(
                        VicoVpnService.EXTRA_FREE_FAILED,
                        0
                    )

                val message =
                    intent.getStringExtra(
                        VicoVpnService.EXTRA_FREE_MESSAGE
                    ).orEmpty()

                val finished =
                    intent.getBooleanExtra(
                        VicoVpnService.EXTRA_FREE_FINISHED,
                        false
                    )

                val success =
                    intent.getBooleanExtra(
                        VicoVpnService.EXTRA_FREE_SUCCESS,
                        false
                    )

                lastDiscoveryWorking =
                    maxOf(
                        lastDiscoveryWorking,
                        working
                    )

                if (working > 0) {
                    refreshServerUi()

                    if (
                        connectAfterFreeUpdate &&
                        !smartConnectTriggered
                    ) {
                        smartConnectTriggered = true
                        connectAfterFreeUpdate = false

                        serverStore
                            .activateBestFreeServer()

                        freeTestDialog?.dismiss()
                        freeTestDialog = null

                        toast(
                            getString(
                                R.string.subscription_optimizing_in_background
                            )
                        )

                        requestVpnStart()
                        return
                    }
                }

                if (
                    discoveryUiSuppressed &&
                    !connectAfterFreeUpdate
                ) {
                    if (finished) {
                        binding.subscriptionLastResultText.text =
                            if (
                                success &&
                                lastDiscoveryWorking > 0
                            ) {
                                getString(
                                    R.string.subscription_last_update_success,
                                    lastDiscoveryWorking
                                )
                            } else {
                                message
                            }

                        discoveryUiSuppressed = false
                        smartConnectTriggered = false
                        lastDiscoveryWorking = 0
                    }

                    return
                }

                updateFreeTestProgressUi(
                    completed = completed,
                    total = total,
                    working = working,
                    failed = failed,
                    message = message,
                    finished = finished,
                    success = success
                )
            }
        }

