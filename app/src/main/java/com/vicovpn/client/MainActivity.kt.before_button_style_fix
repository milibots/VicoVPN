    private fun importServer(rawLink: String) {
        val parsed = runCatching {
            ShareLinkParser.parse(rawLink)
        }.getOrElse { error ->
            toast(error.message ?: getString(R.string.invalid_profile))
            return
        }

        val saved = serverStore.addServer(
            name = parsed.name,
            rawLink = rawLink,
            protocol = protocolName(parsed),
            address = parsed.address,
            port = parsed.port,
            transport = parsed.transport.network.uppercase()
        )

        serverStore.setActiveServer(saved.id)
        refreshServerUi()
        toast(getString(R.string.server_saved))
        selectTab(MainTab.SERVERS, force = true)
    }

    private fun protocolName(profile: ProxyProfile): String {
        return when (profile) {
            is ProxyProfile.Vmess -> "VMess"
            is ProxyProfile.Vless -> "VLESS"
            is ProxyProfile.Trojan -> "Trojan"
            is ProxyProfile.Shadowsocks -> "Shadowsocks"
        }
    }

    private fun refreshServerUi() {
        refreshFreeSettingsUi()
        val servers = serverStore.getServers()
        val activeServer = serverStore.getActiveServer()

        binding.serversEmptyCard.visibility =
            if (servers.isEmpty()) View.VISIBLE else View.GONE
        binding.serversListContainer.visibility =
            if (servers.isEmpty()) View.GONE else View.VISIBLE

        binding.serversListContainer.removeAllViews()
        servers.forEach { server ->
            binding.serversListContainer.addView(
                createServerCard(
                    server = server,
                    isActive = server.id == activeServer?.id
                )
            )
        }

        if (activeServer == null) {
            binding.noActiveServerCard.visibility = View.VISIBLE
            binding.activeServerCard.visibility = View.GONE
            binding.activeServerLatencyText.text =
                "—"
        } else {
            binding.noActiveServerCard.visibility = View.GONE
            binding.activeServerCard.visibility = View.VISIBLE
            binding.activeServerName.text = activeServer.name
            binding.activeServerDetails.text =
                "${activeServer.protocol} • ${activeServer.transport}"
            binding.activeServerAddress.text =
                "${activeServer.address}:${activeServer.port}"

            binding.activeServerLatencyText.text =
                if (
                    activeServer.latencyMs > 0
                ) {
                    "${activeServer.latencyMs}ms"
                } else {
                    "—"
                }
        }

        updateNetworkAvailabilityUi()
    }

