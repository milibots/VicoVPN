    }

    private fun createDiagnosticsText(state: VpnSnapshot): String {
        return buildString {
            appendLine("stage=${state.stage}")
            appendLine("server=${state.serverName}")
            appendLine("exitIp=${state.exitIp.ifBlank { "unavailable" }}")
            appendLine("countryCode=${state.countryCode}")
            appendLine("countryName=${state.countryName}")
            appendLine("region=${state.region}")
            appendLine("city=${state.city}")
            appendLine("isp=${state.isp}")
            appendLine("asn=${state.asn}")
            appendLine("locationProvider=${state.locationProvider}")
            appendLine("message=${state.message}")
            appendLine(
                "nativeAar=${
                    if (runCatching { Class.forName("libv2ray.Libv2ray") }.isSuccess) {
                        "present"
                    } else {
                        "missing"
                    }
                }"
            )
            appendLine("---")
            append(DiagnosticsLog.snapshot())
        }
    }

    private fun buildLocationLine(state: VpnSnapshot): String {
        val place = listOf(
            state.countryName,
            state.city
        ).filter { it.isNotBlank() }
            .distinct()
            .joinToString(" · ")

        if (place.isBlank()) return ""

        val flag = countryCodeToFlag(state.countryCode)
        return listOf(flag, place)
            .filter { it.isNotBlank() }
            .joinToString(" ")
    }

    private fun buildNetworkLine(state: VpnSnapshot): String {
        return listOf(
            state.isp,
            state.asn
        ).filter { it.isNotBlank() }
            .distinct()
            .joinToString(" · ")
    }

    private fun countryCodeToFlag(countryCode: String): String {
        val code = countryCode.trim().uppercase()
        if (code.length != 2 || code.any { it !in 'A'..'Z' }) return ""

        return code.map { character ->
            String(
                Character.toChars(
                    0x1F1E6 + character.code - 'A'.code
                )
            )
        }.joinToString("")
    }

