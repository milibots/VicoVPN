    private fun configureDiscoveryButtons(
        working: Int,
        finished: Boolean
    ) {
        if (working > 0) {
            freeTestCenterButton?.apply {
                isEnabled = true
                text =
                    getString(
                        R.string.connect_now
                    )

                setOnClickListener {
                    serverStore
                        .activateBestFreeServer()

                    freeTestDialog?.dismiss()
                    freeTestDialog = null

                    toast(
                        getString(
                            R.string.subscription_optimizing_in_background
                        )
                    )

                    requestVpnStart()
                }
            }

            freeTestActionButton?.apply {
                visibility = View.VISIBLE
                isEnabled = true
                text =
                    if (finished) {
                        getString(
                            R.string.close
                        )
                    } else {
                        getString(
                            R.string.enough_for_now
                        )
                    }

                setOnClickListener {
                    if (finished) {
                        freeTestDialog?.dismiss()
                        freeTestDialog = null
                    } else {
                        requestDiscoveryStop()
                    }
                }
            }
        } else {
            freeTestCenterButton?.apply {
                isEnabled = true
                text =
                    getString(
                        R.string.stop
                    )

                setOnClickListener {
                    requestDiscoveryStop()
                }
            }

            freeTestActionButton?.visibility =
                View.GONE
        }
    }

    private fun requestDiscoveryStop() {
        val activeImporter =
            subscriptionImporter

        if (activeImporter != null) {
            activeImporter.cancel()

            freeTestCenterButton
                ?.isEnabled = false

            freeTestActionButton
                ?.isEnabled = false

            freeTestStatus?.text =
                getString(
                    R.string.subscription_cancelling
                )

            return
        }

        startService(
            Intent(
                this,
                VicoVpnService::class.java
            ).setAction(
                VicoVpnService
                    .ACTION_CANCEL_FREE_TEST
            )
        )

        freeTestCenterButton
            ?.isEnabled = false

        freeTestActionButton
            ?.isEnabled = false

        freeTestStatus?.text =
            getString(
                R.string.subscription_finishing_current_batch
            )
    }

