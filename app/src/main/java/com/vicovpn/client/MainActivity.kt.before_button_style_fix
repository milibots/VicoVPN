    private fun restoreSavedLanguage() {
        val preferences = getSharedPreferences(
            SETTINGS_PREFERENCES,
            MODE_PRIVATE
        )

        val languageWasSelected = preferences.getBoolean(
            KEY_LANGUAGE_SELECTED,
            false
        )
        val savedLanguage = preferences.getString(KEY_LANGUAGE, null)

        if (!languageWasSelected || savedLanguage.isNullOrBlank()) return

        val currentLanguage = AppCompatDelegate
            .getApplicationLocales()
            .toLanguageTags()

        if (currentLanguage != savedLanguage) {
            AppCompatDelegate.setApplicationLocales(
                LocaleListCompat.forLanguageTags(savedLanguage)
            )
        }
    }

