    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        setIntent(intent)
        handleSharedText(intent)
    }

    override fun onStart() {
        super.onStart()

        networkStateMonitor.start()

        if (
            snapshot.stage ==
                VpnStage.CONNECTED
        ) {
            uiHandler.removeCallbacks(
                connectionTimerRunnable
            )
            uiHandler.post(
                connectionTimerRunnable
            )
        }

        val filter = IntentFilter(
            VpnStateRepository.ACTION_STATE
        )

        val freeFilter = IntentFilter(
            VicoVpnService.ACTION_FREE_TEST_PROGRESS
        )

        if (
            Build.VERSION.SDK_INT >=
            Build.VERSION_CODES.TIRAMISU
        ) {
            registerReceiver(
                receiver,
                filter,
                RECEIVER_NOT_EXPORTED
            )
            registerReceiver(
                freeTestReceiver,
                freeFilter,
                RECEIVER_NOT_EXPORTED
            )
        } else {
            registerLegacyReceiver(filter)
            registerLegacyFreeReceiver(freeFilter)
        }

        refreshServerUi()
        render(VpnStateRepository.get())
    }

    override fun onDestroy() {
        subscriptionImporter?.cancel()
        subscriptionExecutor.shutdownNow()
        uiHandler.removeCallbacksAndMessages(
            null
        )
        super.onDestroy()
    }

    override fun onStop() {
        networkStateMonitor.stop()
        uiHandler.removeCallbacks(
            connectionTimerRunnable
        )

        runCatching {
            unregisterReceiver(receiver)
        }
        runCatching {
            unregisterReceiver(freeTestReceiver)
        }
        super.onStop()
    }

